local GiveItemModule = {}
GiveItemModule.slotIds = { "1","2","3","4","5","6","7","8","9","0" }
GiveItemModule.keyMap = {
    ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two, ["3"] = Enum.KeyCode.Three,
    ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five, ["6"] = Enum.KeyCode.Six,
    ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight, ["9"] = Enum.KeyCode.Nine,
    ["0"] = Enum.KeyCode.Zero
}

function GiveItemModule.getInventory()
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local ig = pg:FindFirstChild("Ingame")
    if not ig then return nil end
    return ig:FindFirstChild("Inventory")
end

function GiveItemModule.equipSlot(slotName)
    pcall(function()
        local key = GiveItemModule.keyMap[slotName]
        if key then
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end
    end)
end

function GiveItemModule.isSlotValid(slot)
    if not slot or not slot:FindFirstChild("Values") or not slot.Values:FindFirstChild("ItemName") then return false end
    if slot.Values.ItemName.Value == "" then return false end
    return true
end

function GiveItemModule.findItemSlot(inventory, itemName)
    for _, slotName in ipairs(GiveItemModule.slotIds) do
        local slot = inventory:FindFirstChild(slotName)
        if slot and GiveItemModule.isSlotValid(slot) and slot.Values.ItemName.Value == itemName then
            return slotName
        end
    end
    return nil
end

function GiveItemModule.findEmptySlot(inventory)
    for _, slotName in ipairs(GiveItemModule.slotIds) do
        local slot = inventory:FindFirstChild(slotName)
        if not slot or not GiveItemModule.isSlotValid(slot) then return slotName end
    end
    return nil
end

function GiveItemModule.giveItem(itemName, itemImage)
    pcall(function()
        local inventory = GiveItemModule.getInventory()
        if not inventory then return end
        local existing = GiveItemModule.findItemSlot(inventory, itemName)
        if existing then
            GiveItemModule.equipSlot(existing)
            Library:Notify(itemName .. " 已在背包中!", 3)
            return
        end
        local emptySlot = GiveItemModule.findEmptySlot(inventory)
        if not emptySlot then
            Library:Notify("背包已满!", 3)
            return
        end
        local template = nil
        for _, slotName in ipairs(GiveItemModule.slotIds) do
            local s = inventory:FindFirstChild(slotName)
            if s and GiveItemModule.isSlotValid(s) then template = s:Clone(); break end
        end
        if not template then
            Library:Notify("物品发放失败!", 3)
            return
        end
        local old = inventory:FindFirstChild(emptySlot)
        if old then old:Destroy() end
        template.Parent = inventory
        template.Name = emptySlot
        template.Values.ItemName.Value = itemName
        template.Icon.Image = itemImage
        template.Number.Text = emptySlot
        task.wait(0.1)
        GiveItemModule.equipSlot(emptySlot)
        Library:Notify(itemName .. " 已添加到背包!", 3)
    end)
end


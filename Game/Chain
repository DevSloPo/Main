local function simulateKeyPress(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function simulateMouseClick(button)
    pcall(function()
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local center = absPos + absSize / 2
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
    end)
end

local function tryFireQTE(frame)
    local ib = frame:FindFirstChild("ImageButton")
    if not ib then return end

    pcall(function()
        for _, conn in pairs(getconnections(ib.Activated)) do
            conn:Fire()
        end
    end)

    simulateMouseClick(ib)

    local pc = ib:FindFirstChild("PC")
    local keyName = pc and pc.Text or ""
    local ek = Enum.KeyCode[keyName]
    if ek then
        simulateKeyPress(ek)
    end
end

local function setupQTE(frame)
    if not frame then return end
    local conn = frame:GetPropertyChangedSignal("Visible"):Connect(function()
        if autoQTEActive and frame.Visible then
            tryFireQTE(frame)
        end
    end)
    table.insert(qteConns, conn)
    if frame.Visible and autoQTEActive then
        tryFireQTE(frame)
    end
end

local function startQPoll()
    if qtePollConn then qtePollConn:Disconnect() end
    qtePollConn = RS.Heartbeat:Connect(function()
        if not autoQTEActive then return end
        for _, name in ipairs(QTEFrames) do
            local frame = MechanicsFrame:FindFirstChild(name)
            if frame and frame.Visible then
                tryFireQTE(frame)
            end
        end
    end)
end

local function stopQPoll()
    if qtePollConn then qtePollConn:Disconnect(); qtePollConn = nil end
end

local function initQTE()
    for _, conn in ipairs(qteConns) do conn:Disconnect() end
    qteConns = {}
    if autoQTEActive then
        for _, name in ipairs(QTEFrames) do
            setupQTE(MechanicsFrame:FindFirstChild(name))
        end
        startQPoll()
    else
        stopQPoll()
    end
end


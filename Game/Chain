local UI_Errors = {}
local UI_OK = 0
local function UI(builder, tag)
    local ok, err = pcall(builder)
    if ok then
        UI_OK = UI_OK + 1
    else
        table.insert(UI_Errors, tostring(tag) .. " -> " .. tostring(err))
        warn("[XKHUB] UI构建失败 " .. tostring(tag) .. " :: " .. tostring(err))
    end
end

local function SafeGroupbox(tab, side, name, icon)
    local fn = (side == "Right") and tab.AddRightGroupbox or tab.AddLeftGroupbox
    if type(fn) == "function" then
        local ok, box = pcall(fn, tab, name, icon)
        if ok and box then return box end
    end
    local ok2, box2 = pcall(function()
        return tab:AddGroupbox({ Side = side, Name = name, IconName = icon })
    end)
    if ok2 and box2 then return box2 end
    local msg = "分组框[" .. tostring(name) .. "] 创建失败: " .. tostring(box2)
    table.insert(UI_Errors, msg)
    warn("[XKHUB] " .. msg)
    return nil
end


local animAccelHooked = false

local function setupAnimAccel()
    if animAccelHooked then return true end
    local SPEED = 100
    local animIDs = {
        ["rbxassetid://14195881288"] = true,
        ["rbxassetid://14825991179"] = true,
        ["rbxassetid://14217754110"] = true,
    }
    local ok = false
    pcall(function()
        local char = lp.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local animator = hum and hum:FindFirstChild("Animator")
        if not animator then return end
        if _G._itemAccelConn then _G._itemAccelConn:Disconnect() end
        _G._itemAccelConn = animator.AnimationPlayed:Connect(function(track)
            if not State.ItemAccel then return end
            local id = track.Animation and track.Animation.AnimationId
            if id and animIDs[id] then
                pcall(function() track:AdjustSpeed(SPEED) end)
            end
        end)
        ok = true
    end)
    animAccelHooked = ok
    return ok
end


task.spawn(function()
    local gui = Library.ScreenGui
    if not gui then return end

    local TITLE = "XKHUB"

    local function hsv(h, s, v)
        h = h - math.floor(h)
        local i = math.floor(h * 6)
        local f = h * 6 - i
        local p = v * (1 - s)
        local q = v * (1 - f * s)
        local t = v * (1 - (1 - f) * s)
        i = i % 6
        local r, g, b
        if i == 0 then r, g, b = v, t, p
        elseif i == 1 then r, g, b = q, v, p
        elseif i == 2 then r, g, b = p, v, t
        elseif i == 3 then r, g, b = p, q, v
        elseif i == 4 then r, g, b = t, p, v
        else r, g, b = v, p, q end
        return math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5)
    end

    local function rainbow(offset)
        local parts = {}
        local len = #TITLE
        for i = 1, len do
            local r, g, b = hsv((i - 1) / len + offset, 1, 1)
            parts[i] = string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, TITLE:sub(i, i))
        end
        return table.concat(parts)
    end

    local titleLabel = nil
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text == TITLE then
            titleLabel = d
            break
        end
    end

    if titleLabel then
        for _, c in ipairs(titleLabel:GetChildren()) do
            if c:IsA("UIGradient") then c.Parent = nil end
        end
        titleLabel.RichText = true
    end

    local offset = 0
    while true do
        pcall(function()
            Window:ChangeTitle(rainbow(offset))
            if titleLabel then titleLabel.RichText = true end
        end)
        offset = (offset + 0.03) % 1
        task.wait(0.06)
    end
end)


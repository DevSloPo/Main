mt.__namecall = function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if method == "FireServer" and self == CTS and not LastCTSArgs then
        if args[1] == "Dodge1" then
            LastCTSArgs = args
        end
    end

    if method == "FireServer" and self == interactRemote then
    
    if State.AutoSwing and not LastSwingArgs then
    LastSwingArgs = args
    end
    
    if crucifxLoopEnabled and args[1] == "CrucifixSuccess" then
    crucifxArgs = args
end

        if State.GodmodeQTE and not LastQTEArgs then
    LastQTEArgs = args
    end
    
        if gunAuraCapturing and not gunAuraArgs then
            gunAuraArgs = args
        end
        if autoSealEnabled and args[1] == "SpellBookBegin" then
            local currentId = args[3]
            task.spawn(function()
                pcall(function()
                    interactRemote:FireServer("SpellBookSuccess", nil, currentId)
                end)
            end)
        end
    end

    if method == "InvokeServer" and self == InflictTarget then

local function attemptDodge()
    pcall(function()
        if CTS and LastCTSArgs then
            CTS:FireServer(unpack(LastCTSArgs))
        end
    end)
end

local function getChain()
    local misc = W:FindFirstChild("Misc")
    if not misc then return nil end
    local ai = misc:FindFirstChild("AI")
    if not ai then return nil end
    return ai:FindFirstChild("CHAIN")
end

local function checkAnimId(id)
    if chokeEnabled and id:find(chokeAnimId) then
        return true
    end
    if screamEnabled then
        for _, sid in ipairs(screamAnimIds) do
            if id:find(sid) then return true end
        end
    end
    return false
end

local function bindChainAnimEvents(chain)
    pcall(function()
        local humanoid = chain:FindFirstChild("Humanoid")
        if not humanoid then return end
        humanoid.AnimationPlayed:Connect(function(track)
            pcall(function()
                if not LastCTSArgs then return end
                local char = lp.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local chainHrp = chain:FindFirstChild("HumanoidRootPart")
                if not chainHrp then return end
                local dist = (hrp.Position - chainHrp.Position).Magnitude
                if dist > 14 then return end
                local anim = track.Animation
                if not anim then return end
                local id = tostring(anim.AnimationId)
                if checkAnimId(id) then
                    attemptDodge()
                end
            end)
        end)
    end)
end

RS.Heartbeat:Connect(function()
    pcall(function()
        local chain = getChain()
        if chain and chain ~= boundChain then
            boundChain = chain
            bindChainAnimEvents(chain)
        end

        if not chokeEnabled and not screamEnabled then return end
        if not LastCTSArgs then return end
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if not chain then return end
        local chainHrp = chain:FindFirstChild("HumanoidRootPart")
        local humanoid = chain:FindFirstChild("Humanoid")
        if not chainHrp or not humanoid then return end
        local dist = (hrp.Position - chainHrp.Position).Magnitude
        if dist > 14 then return end

        local currentTracks = humanoid:GetPlayingAnimationTracks()
        local currentSet = {}
        for i = 1, #currentTracks do
            local track = currentTracks[i]
            local anim = track.Animation
            if anim then
                local id = tostring(anim.AnimationId)
                currentSet[id] = true
                if not lastKnownTracks[id] then
                    if checkAnimId(id) then
                        attemptDodge()
                    end
                end
            end
        end
        lastKnownTracks = currentSet
    end)
end)


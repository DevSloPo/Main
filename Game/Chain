local function isStationElectrified(station)
    if not station then return false end
    if station:GetAttribute("Electrified") == true then return true end
    if station:GetAttribute("Powered") == true then return true end
    for _, desc in ipairs(station:GetDescendants()) do
        if desc:IsA("ParticleEmitter") and desc.Enabled then
            local n = string.lower(desc.Name)
            if string.find(n, "spark") or string.find(n, "electric") or string.find(n, "shock") or string.find(n, "arc") then
                return true
            end
        end
    end
    local alertUI = station:FindFirstChild("AlertUI")
    if alertUI then
        local gui = alertUI:FindFirstChild("GUI")
        if gui and gui.Enabled then return true end
    end
    return false
end

UI(function()
F_AutoPower:AddToggle("AutoPower", {
        Text = "自动发电机",
        Default = false,
        Tooltip = "低FPS容易被电",

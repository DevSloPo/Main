                            local station = GameSections:FindFirstChild("POWERSTATION")
                            if not hrp then task.wait(1) return end
                            if not station then task.wait(1) return end
    
                            local savedCF = hrp.CFrame
                            local prompt = station:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt and prompt.Parent then
                                hrp.CFrame = prompt.Parent.CFrame * CFrame.new(0, 0, 3)
                            else
                                hrp.CFrame = CFrame.new(-306.6, -107.3, -232.5)
                            end
                            task.wait(0.2)
    
                            local startTime = tick()
                            while State.AutoPower and tick() - startTime < 45 do
                                local curPower = valuesFolder:GetAttribute("Power")
